# See https://help.github.com/articles/ignoring-files/ for more about ignoring files.

# dependencies
/node_modules
# bun.lock is the ONLY lockfile: CI and release both run `bun install --frozen-lockfile`, so a
# lockfile from another package manager is never validated and can drift from what ships.
pnpm-lock.yaml
package-lock.json
yarn.lock
/.pnp
.pnp.*
.yarn/*
!.yarn/patches
!.yarn/plugins
!.yarn/releases
!.yarn/versions

# testing
/coverage

# next.js
/.next/
/out/

# production
/build

# misc
.DS_Store
*.pem

# debug
npm-debug.log*
yarn-debug.log*
yarn-error.log*
.pnpm-debug.log*

# env files (can opt-in for committing if needed)
.env*

# vercel
.vercel

# typescript
*.tsbuildinfo
next-env.d.ts

# anton local state (ephemeral, not shared)
anton.db
anton.db-*
.anton/
.stringer/
# Written beside anton.db at every server boot (anton-pzfb) — on a source checkout that is the repo
# root, and the record holds a pid and a boot timestamp. One file per running server, named for its
# pid; the glob is kept in sync with BUILD_RECORD_PREFIX (src/lib/build/identity.mjs), which
# identity.test.ts asserts is ignored here.
server-build.*.json

# Beads / Dolt files (added by bd init)
.dolt/
*.db
.beads-credential-key

# Prebuilt release bundles (anton-1xp) — built in CI, never committed
dist/

# Claude Code isolation worktrees (anton-bqge) — a second checkout of the whole tree lands here;
# committing one would re-walk it on every scan and duplicate-flag the entire codebase.
.claude/worktrees/

# Any other in-repo git worktree (anton-fj1q) — same failure, whatever directory it's checked out
# at: a second full copy of the tree that must never be committable.
.worktrees/

# TOMBSTONE — graft is removed (see the removal commit), but git does NOT delete an ignored,
# untracked directory when you pull. Any checkout or worktree that ever ran `graft build` still
# holds its generated cache (in fati's main checkout that was 147MB across ~2.6k files). Drop this
# rule and that tree appears in `git status` on the next pull, one `git add -A` away from being
# committed, and ripgrep starts serving its stale cards as if they were source. Keeping it costs
# nothing where no cache exists; delete it only once none do.
/graft/
