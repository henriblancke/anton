# See https://help.github.com/articles/ignoring-files/ for more about ignoring files.

# dependencies
/node_modules
# bun.lock is the ONLY lockfile: CI and release both run `bun install --frozen-lockfile`, so a
# lockfile from another package manager is never validated and can drift from what ships.
pnpm-lock.yaml
package-lock.json
yarn.lock
/.pnp
.pnp.*
.yarn/*
!.yarn/patches
!.yarn/plugins
!.yarn/releases
!.yarn/versions

# testing
/coverage

# next.js
/.next/
/out/

# production
/build

# misc
.DS_Store
*.pem

# debug
npm-debug.log*
yarn-debug.log*
yarn-error.log*
.pnpm-debug.log*

# env files (can opt-in for committing if needed)
.env*

# vercel
.vercel

# typescript
*.tsbuildinfo
next-env.d.ts

# anton local state (ephemeral, not shared)
anton.db
anton.db-*
.anton/
.stringer/

# Beads / Dolt files (added by bd init)
.dolt/
*.db
.beads-credential-key

# Prebuilt release bundles (anton-1xp) — built in CI, never committed
dist/

# Claude Code isolation worktrees (anton-bqge) — a second checkout of the whole tree lands here;
# committing one would re-walk it on every scan and duplicate-flag the entire codebase.
.claude/worktrees/
